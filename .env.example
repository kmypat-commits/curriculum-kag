# Database Configuration
POSTGRES_USER=curriculum_user
POSTGRES_PASSWORD=curriculum_pass
POSTGRES_DB=curriculum_kag

# Backend Configuration
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
DATABASE_URL=postgresql://curriculum_user:curriculum_pass@localhost:5432/curriculum_kag

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# LLM Configuration (choose provider: openai, anthropic, or local)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-4

# For Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your-anthropic-key
# LLM_MODEL_NAME=claude-3-opus-20240229

# For local models (e.g., Ollama)
# LLM_PROVIDER=local
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL_NAME=llama2

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000

# KAG Configuration
SIMILARITY_THRESHOLD=0.82
COVERAGE_THRESHOLD=0.60
MAX_BRIDGE_MODULES=5
TOP_K_RETRIEVAL=20
NSGA2_POPULATION=100
NSGA2_GENERATIONS=200
NSGA2_CROSSOVER_PROBABILITY=0.9
NSGA2_MUTATION_PROBABILITY=0.1

# Localization
DEFAULT_LANGUAGE=ru
SUPPORTED_LANGUAGES=ru,kz,en
