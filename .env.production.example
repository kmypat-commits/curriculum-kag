# Copy to .env.production and fill real values. Never commit the filled file.
DOMAIN=example.org
ALLOWED_HOSTS=["example.org"]
CORS_ORIGINS=["https://example.org"]
POSTGRES_USER=curriculum_user
POSTGRES_PASSWORD=change-this-long-password
POSTGRES_DB=curriculum_kag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://curriculum_user:change-this-long-password@postgres:5432/curriculum_kag
BACKEND_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443
SECRET_KEY=change-this-random-secret
AUTH_COOKIE_SECURE=true
# CLI automation tokens are shorter-lived than browser sessions.
CLI_TOKEN_EXPIRE_MINUTES=60
DOCS_ENABLED=false
GIT_UI_ENABLED=false
MAX_REQUEST_BYTES=2097152
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_BUILD_PER_TEN_MINUTES=8
RATE_LIMIT_EXPENSIVE_PER_TEN_MINUTES=10
ASYNC_BUILDS=true
# Build progress is persisted in PostgreSQL; keep the status table migrated
# before enabling multiple backend workers.
WEB_CONCURRENCY=1
AUDIT_TELEMETRY_RETENTION_DAYS=365
PLANNER_P95_BUDGET_MS=300000
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4
EMBEDDING_MODEL_NAME=models/epvo-sbert-finetuned-40k
MODEL_DIR=./backend/models/epvo-sbert-finetuned-40k
ENABLE_SBERT=true
SBERT_DEVICE=cpu
EPVO_AI_ENABLED=true
EPVO_AI_THRESHOLD=0.3449310730397701
EXPERT_EVIDENCE_REPOSITORY_NAME=Curriculum Expert Evidence Repository
EXPERT_EVIDENCE_REPOSITORY_SLUG=ceer
